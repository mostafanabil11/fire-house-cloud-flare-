# Cache rules for the static files Cloudflare serves without running the Worker.

# Build output: every filename carries a content hash, so a changed file is a
# new URL and the old one can be cached forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Photos keep their names when replaced, so they get a day — and may be served
# stale for a week while the browser re-checks in the background.
/images/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
